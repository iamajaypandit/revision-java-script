//Daimond Printing 

function pattern(n){
    for(let i=0;i<n;i++){
        let star = "";

        //space
        for(let j=0;j<n-i-1;j++){
            star += " " ;
        }

        //star
        for(let j=0;j<2*i+1;j++){
            star += "*";
        }

        //space
        for(let j=0;j<n-i-1;j++){
            star += " ";
        }

        console.log(star);
    }
    for(let i=n-2;i>=0;i--){
        let star = "";
        //space
        for(let j=0;j<n-i-1;j++){
            star += " ";
        }

        //star
        for(let j=0;j<2*i+1;j++){
            star += "*";
        }

        //space
        for(let j=0;j<n-i-1;j++){
            star += " ";
        }

        console.log(star);
    }
}

