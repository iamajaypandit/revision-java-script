// for alphabet printing 
function pattern(n) {
    
    for (let i = 0; i < n; i++) {
        let star = "";
        let num = 65;
        for(let j=0;j<i+1;j++){
            star += String.fromCharCode(num);
            num++;
        }
        console.log(star)
    }
    for (let i=n-2;i>=0;i--) {
        let star = "";
        let num = 65;
        for(let j=0;j<i+1;j++){
            star += String.fromCharCode(num);
            num++;
        }
        console.log(star)
    }
}
