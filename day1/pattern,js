// hallow tringle 
function pattern(n) {
    for (let i = 0; i < n; i++) {
        let star = "";
        //space
        for (let j = 0; j < n - i - 1; j++) {
            star += " " + " ";
        }
        //star
        for (let j = 0; j < i + 1; j++) {
            if (j==0||j==i||i==n-1) {
                star += "*" + " ";
            } else {
                star += " " + " ";
            }
        }
        console.log(star)
    }
}
